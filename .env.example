# energy-optimizer configuration. Copy to .env and edit.
# All variables are prefixed with EO_ and can also be set as real environment variables.

# --- General ---
EO_MODE=dry_run                     # dry_run | control (control also needs enable + arm token)
EO_TZ=Europe/Warsaw
EO_DB=/data/energy_optimizer.sqlite
EO_HTTP_HOST=0.0.0.0
EO_HTTP_PORT=8320
EO_LOG_LEVEL=INFO

# --- Home Assistant ---
EO_HA_URL=http://homeassistant.local:8123
EO_HA_TOKEN=                        # long-lived access token
EO_HA_VERIFY_SSL=true

# --- Pstryk (unified-metrics) ---
EO_PSTRYK_API_KEY=                  # sent as Authorization header, no Bearer prefix
EO_PSTRYK_BASE_URL=https://api.pstryk.pl
EO_PSTRYK_HISTORY_BOOTSTRAP_DAYS=21 # 14-30 days of historical prices to backfill on start

# --- MQTT (Home Assistant discovery) ---
EO_MQTT_HOST=
EO_MQTT_PORT=1883
EO_MQTT_USERNAME=
EO_MQTT_PASSWORD=
EO_MQTT_TLS=false
EO_MQTT_DISCOVERY_PREFIX=homeassistant
EO_MQTT_NODE_ID=energy_optimizer
EO_MQTT_CLIENT_ID=energy_optimizer
EO_MQTT_ENABLED=true

# --- Battery / site parameters (required; do not infer from ratings) ---
EO_BATTERY_CAPACITY_KWH=18.08
EO_BATTERY_MAX_CHARGE_KW=8.8
EO_BATTERY_MAX_DISCHARGE_KW=9.6
EO_BATTERY_HARD_SOC_MIN_PCT=0 # displayed usable-empty; BMS retains its protection buffer
EO_BATTERY_SOC_MIN_PCT=15 # operating reserve protected from house discharge/export
EO_BATTERY_SOC_MAX_PCT=98
EO_BATTERY_ROUND_TRIP_EFFICIENCY=0.90       # eta_c = eta_d = sqrt(this)
EO_DEGRADATION_COST_PLN_PER_KWH=0.05        # per kWh of battery-side throughput, no implicit /2

# Site grid + inverter limits (Sigen Hybrid 6.0 TP2 defaults)
EO_SITE_IMPORT_LIMIT_KW=11.0
EO_SITE_EXPORT_LIMIT_KW=6.6
EO_INVERTER_LIMIT_KW=6.0

# --- Pricing model ---
EO_IMPORT_PRICE_ADJUSTMENT_PLN_KWH=0.0      # only for invoice components proven missing

# --- Optimiser feature flags / safety margins ---
EO_ALLOW_BATTERY_EXPORT=true
EO_ALLOW_GRID_CHARGING=true
EO_MINIMUM_EXPORT_SPREAD_PLN_KWH=0.30
EO_GRID_CHARGE_MARGIN_PLN_KWH=0.30
EO_TERMINAL_SOC_SALVAGE_PLN_KWH=0.0
EO_OPTIMISE_HORIZON_HOURS=48
EO_STEP_MINUTES=15

# --- EV / PHEV flexible load / charger relay control ---
# Stationary battery control remains disabled. This opt-in controls only the charger relay.
# Replace example entity IDs with your Home Assistant entities.
EO_EV_CONTROL_ENABLED=false
EO_EV_SWITCH_ENTITY=switch.ev_charger
EO_EV_POWER_ENTITY=sensor.ev_charger_power
EO_EV_SOC_ENTITY=sensor.ev_state_of_charge
EO_EV_CHARGING_STATUS_ENTITY=sensor.ev_charging_status
EO_EV_CHARGING_ACTIVE_ENTITY=binary_sensor.ev_charging_active
# When ON, this existing HA input bypasses economic scheduling and charges immediately.
EO_EV_CHARGE_TO_100_ENTITY=input_boolean.ev_charge_to_100_once
EO_EV_UNPLUGGED_STATUS=3
EO_EV_START_CHARGING_STATUSES=["2"]
EO_EV_ACTIVE_CHARGING_STATUSES=["0","1","2","5","6","9","10","11","12","13","14","15"]
EO_EV_FAULT_ENTITIES=["binary_sensor.ev_charger_overheating","binary_sensor.ev_charger_overpowering","binary_sensor.ev_charger_overcurrent","binary_sensor.ev_charger_overvoltage"]
EO_EV_CAPACITY_KWH=10.9
EO_EV_CHARGE_POWER_KW=1.8
EO_EV_CHARGE_EFFICIENCY=0.90
EO_EV_MINIMUM_TARGET_SOC_PCT=50
EO_EV_DEPARTURE_HOUR=9
EO_EV_MIN_ON_MINUTES=5
EO_EV_MIN_OFF_MINUTES=5
EO_EV_POWER_START_GRACE_MINUTES=5
EO_EV_MIN_CHARGING_POWER_KW=0.1

# --- Stationary battery control (fail-safe; OFF by default) ---
# Two independent gates plus documented arm token are required for mode=control.
# Planner flags EO_ALLOW_GRID_CHARGING / EO_ALLOW_BATTERY_EXPORT are NOT actuation gates.
# Leave the arm token empty here; never commit a live arm token.
EO_BATTERY_CONTROL_ENABLED=false
EO_BATTERY_CONTROL_ARM_TOKEN=
EO_BATTERY_EXPORT_ENABLED=false
EO_BATTERY_CONTROL_GRID_CHARGE_ENABLED=false
EO_BATTERY_CONTROL_AUTHORIZE_DISCHARGE=false
EO_BATTERY_CONTROL_AUTHORIZE_EXPORT=false
# Remains false until HA number-register read-back is proven reliable (contract defect).
EO_BATTERY_CONTROL_NUMBER_REGISTER_ACK_RELIABLE=false
EO_BATTERY_CONTROL_SUPPORTED_DIRECTIONS=["FALLBACK","IDLE","CHARGE"]

# Entity IDs from docs/sigenergy-control-contract.md
EO_BATTERY_CONTROL_REMOTE_EMS_SWITCH_ENTITY=switch.sigen_plant_remote_ems_controlled_by_home_assistant
EO_BATTERY_CONTROL_MODE_SELECT_ENTITY=select.sigen_plant_remote_ems_control_mode
EO_BATTERY_CONTROL_CHARGE_LIMIT_ENTITY=number.sigen_plant_ess_max_charging_limit
EO_BATTERY_CONTROL_DISCHARGE_LIMIT_ENTITY=number.sigen_plant_ess_max_discharging_limit
EO_BATTERY_CONTROL_CHARGE_CUTOFF_ENTITY=number.sigen_plant_ess_charge_cut_off_state_of_charge
EO_BATTERY_CONTROL_DISCHARGE_CUTOFF_ENTITY=number.sigen_plant_ess_discharge_cut_off_state_of_charge
EO_BATTERY_CONTROL_WATCHDOG_HEALTH_ENTITY=
EO_BATTERY_CONTROL_WATCHDOG_ACK_ENTITY=

# Exact mode option strings (Unknown / PCS Remote Control / V2G are rejected)
EO_BATTERY_CONTROL_MODE_STANDBY=Standby
EO_BATTERY_CONTROL_MODE_CHARGE_GRID_FIRST=Command Charging (Grid First)
EO_BATTERY_CONTROL_MODE_CHARGE_PV_FIRST=Command Charging (PV First)
EO_BATTERY_CONTROL_MODE_DISCHARGE_PV_FIRST=Command Discharging (PV First)
EO_BATTERY_CONTROL_MODE_DISCHARGE_ESS_FIRST=Command Discharging (ESS First)
EO_BATTERY_CONTROL_MODE_MAX_SELF_CONSUMPTION=Maximum Self Consumption
EO_BATTERY_CONTROL_COMMAND_MODE=Command Charging (Grid First)
EO_BATTERY_CONTROL_FALLBACK_MODE=Standby
EO_BATTERY_CONTROL_REQUIRE_REMOTE_EMS_OFF=true

# Explicit local-restore values — never take these from HA number fallback states (0.0)
EO_BATTERY_CONTROL_LOCAL_CHARGE_LIMIT_KW=8.8
EO_BATTERY_CONTROL_LOCAL_DISCHARGE_LIMIT_KW=9.6
EO_BATTERY_CONTROL_LOCAL_CHARGE_CUTOFF_PCT=100
EO_BATTERY_CONTROL_LOCAL_DISCHARGE_CUTOFF_PCT=0

EO_BATTERY_CONTROL_MAX_GRID_IMPORT_KW=11.0
EO_BATTERY_CONTROL_MAX_GRID_EXPORT_KW=6.0
EO_BATTERY_CONTROL_MAX_CHARGE_KW=8.8
EO_BATTERY_CONTROL_MAX_DISCHARGE_KW=9.6
EO_BATTERY_CONTROL_MIN_SOC_PCT=15
EO_BATTERY_CONTROL_MAX_SOC_PCT=98
EO_BATTERY_CONTROL_CHARGE_CUTOFF_MARGIN_PCT=0.5
EO_BATTERY_CONTROL_DISCHARGE_CUTOFF_MARGIN_PCT=0.5

EO_BATTERY_CONTROL_CADENCE_SECONDS=30
EO_BATTERY_CONTROL_MAX_PLAN_AGE_SECONDS=900
EO_BATTERY_CONTROL_MAX_TELEMETRY_AGE_SECONDS=120
EO_BATTERY_CONTROL_COMMAND_SETTLE_SECONDS=2
EO_BATTERY_CONTROL_COMMAND_POLL_SECONDS=1
EO_BATTERY_CONTROL_COMMAND_TIMEOUT_SECONDS=30
EO_BATTERY_CONTROL_PHYSICAL_VERIFY_TIMEOUT_SECONDS=15
EO_BATTERY_CONTROL_HEARTBEAT_INTERVAL_SECONDS=15
EO_BATTERY_CONTROL_HEARTBEAT_EXPIRY_SECONDS=60
EO_BATTERY_CONTROL_MIN_DWELL_SECONDS=60
EO_BATTERY_CONTROL_STANDBY_NEUTRAL_BAND_KW=0.12
EO_BATTERY_CONTROL_DEADBAND_KW=0.12
EO_BATTERY_CONTROL_MAX_POWER_STEP_KW=0.5
EO_BATTERY_CONTROL_MAX_RAMP_KW_PER_S=0.5
EO_BATTERY_CONTROL_RETRY_LIMIT=2
EO_BATTERY_CONTROL_LOCKOUT_DURATION_SECONDS=3600
EO_BATTERY_CONTROL_ACTIVATION_MARGIN_PLN_KWH=0.05

# --- PV forecast (Forecast.Solar); one or more planes may be configured ---
EO_PV_LAT=51.9194
EO_PV_LON=19.1451
EO_PV_PLANES=[{"peak_kwp":7.0,"tilt":35,"azimuth":0,"inverter_limit_kw":7.0}]
EO_PV_FORECAST_PROVIDER=forecast_solar       # forecast_solar | solcast | none
EO_SOLCAST_API_KEY=

# --- Optional read-only InfluxDB history bootstrap ---
EO_INFLUXDB_BOOTSTRAP_ENABLED=false
EO_INFLUXDB_URL=
EO_INFLUXDB_TOKEN=
EO_INFLUXDB_ORG=
EO_INFLUXDB_BUCKET=ha_raw
